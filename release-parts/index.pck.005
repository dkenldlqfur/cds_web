c˛êû‡¶œ¬ˆÄÉ®m^j≈Ü‹bÁ´⁄-èÀﬂûO¨∆Õƒ„:¿VC|.Ô=\Û#Œ‘Êqªf¸r%mhºø…ôQˇ$Ã]_7∂ºùsõ@áü·F¯À{¶é›Àœ©Èëˇø9'dw÷ƒ±={áh√ŒX—o˘é’≤Ò´æ£Ø©g/BªDHú¯ç˛ ∏îVÑÏó5§7ÿå®M'˙Û†s” ñ†Û'àˇxªòBiMz_SûN ÁB}®9¸∆
1+Ól;$Ù¨¥ Ωæu∆iÚªcﬁ¬fÖ#∫oÏÙæ:ót˛òº‡Ê€˘ãËˇúﬁË˜ÿ{$73Âì∑õE\·)Ù(?≤◊8øÛÂøz∏ÌÊc˘~}7G]é—ˇa¨øå£Íì’§˘œ›\Pﬂ∑#Ωé;=n‰¶ÅÎ{§∫_∞9WqÓÓÔ¢˛©p=_ƒ,j‰l]6|È	m”ÂX˛n3äN˝aÄcâxF∫œÆZb≤˝$ûqœ␀Ω©Ï‹qÊÎBßú8ﬁ¢öπ;Fíìo]‹N—É‹mﬁ¿†¨‘>8ﬂŒGCÀº¿œøåµÈs#␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;
uniform bool clipped = false;
uniform sampler2D visibility_mask : repeat_disable, filter_nearest;
uniform vec4 frame_uv_rect = vec4(0.0, 0.0, 1.0, 1.0);

void fragment() {
	if (clipped) {
		vec2 mask_uv = (UV - frame_uv_rect.xy) / frame_uv_rect.zw;
		COLOR.a *= texture(visibility_mask, mask_uv).r;
	}
}
