ç];0Lå§Û{Æ7#àûïSagc«Ÿä¼ì÷ÿ‘™5ç[Æå~£É¸-Í£èWž/M—ˆÇçþñºìCŽ¡2”òCÛ{ßÑ…¿;bÍìÃ<·hfðçñ™ýÈ×ÜeKíY7ò?ôp¾sö1n÷îüÏííÛÇûdçÛÖ\‚)šú›ø€ÃÛ‹‡òD,Û”Å=œWÓè—ðo~óñº/ßn¿hÞÒ+Ž%¹möûÖQ8˜,,<Qïßiói/PöúœHë4ÿ³³°¯P‹Ð©úæ>ã‹õ	õl?|[>íâØJ²
üùß	ö —Â¾3=ð\x:eV‰«}Ùûà6«ÙxÉOËeÏç_¡‘õî>Mü9Ü]M\?Þ“7;¾êNÏ½çSvÿâÿå#™äñnP-½—4kúMxÔ¿­Ò®}kµÏ÷A±¼ôKÏ¹ü¿–\ìgáñËŠ.^‚M7␀␀␀␀␀␀␀␀␀␀␀␀␀␀shader_type canvas_item;
render_mode unshaded;

uniform sampler2D label_tags : filter_nearest, repeat_disable;
uniform sampler2D frame_colors : filter_nearest, repeat_disable;
uniform sampler2D frame_palette : filter_nearest, repeat_disable;
uniform bool indexed_frame;
uniform uint document_index;
varying vec2 canvas_pixel;

void vertex() {
    canvas_pixel = (MODEL_MATRIX * vec4(VERTEX, 0.0, 1.0)).xy;
}

void fragment() {
    ivec2 pixel = ivec2(floor(canvas_pixel));
    if (any(lessThan(pixel, ivec2(0))) || any(greaterThanEqual(pixel, textureSize(label_tags, 0)))) {
        discard;
    }
    uvec4 bytes = uvec4(round(texelFetch(label_tags, pixel, 0) * 255.0));
    uint actual = bytes.r | (bytes.g << 8u) | (bytes.b << 16u) | (bytes.a << 24u);
    if ((actual & 0x007fffffu) != document_index) {
        discard;
    }
    vec3 rgb = texelFetch(frame_colors, pixel, 0).rgb;
    if (indexed_frame) {
        int index = (actual & 0x00800000u) != 0u ? int(bytes.a) : int(round(rgb.r * 255.0));
        rgb = texelFetch(frame_palette, ivec2(index, 0), 0).rgb;
    }
    // The CanvasItem fragment COLOR already includes the glyph's sampled alpha.
    COLOR = vec4(rgb * COLOR.rgb, COLOR.a);
}
